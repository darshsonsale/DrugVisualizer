# Drug Path Visualiser - Frontend Environment Configuration Example
# Copy this file to .env for local development

# Backend API Base URL (Standard backend port is 3000)
VITE_API_BASE_URL="http://localhost:3000/api/v1"

# Explicit Development Mock Fallback Flag
# When "true" and in development mode, services fall back to typed mock fixtures if backend is offline.
# In production, this flag is ignored and real API endpoints are always enforced.
VITE_ENABLE_MOCK_FALLBACK="false"
