{
  "name": "drug-path-visualiser-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Drug Path Visualiser - Modular Monolith REST API Backend",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:check": "tsx src/database/checkConnection.ts",
    "db:create": "tsx src/database/createDb.ts",
    "db:test": "tsx src/database/verifySchema.ts",
    "db:test:variations": "tsx src/database/verifyVariations.ts",
    "migrate:up": "tsx src/database/migrator.ts up",
    "migrate:down": "tsx src/database/migrator.ts down",
    "migrate:status": "tsx src/database/migrator.ts status",
    "db:seed": "tsx src/database/seed.ts",
    "test:api": "tsx src/database/verifyApi.ts",
    "db:test:quiz": "tsx src/database/verifyQuizProgress.ts",
    "test:auth": "tsx src/database/verifyAuth.ts",
    "test:authz": "tsx src/database/verifyAuthorization.ts",
    "test:pathways": "tsx src/database/verifyPathways.ts",
    "test:security": "tsx src/database/verifySecurityValidation.ts",
    "test:contract": "tsx src/database/verifyApiContract.ts",
    "test:content": "tsx src/database/verifyContent.ts",
    "test:condition-content": "tsx src/database/verifyConditionContent.ts",
    "test:quiz-bank": "tsx src/database/verifyQuizBank.ts",
    "test:seeder": "tsx src/database/verifySeeder.ts",
    "test:admin-content": "tsx src/database/verifyAdminContent.ts",
    "test:admin-auth": "tsx src/database/verifyDedicatedAdminAuth.ts",
    "test:security-suite": "tsx tests/security/runAllSecurityTests.ts",
    "test:integration": "tsx tests/integration/runAllIntegrationTests.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^11.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
