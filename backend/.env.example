# ===================================================
# Drug Path Visualiser - Backend Environment Configuration Template
# Copy this file to .env for local backend development.
# NEVER commit real credentials, passwords, or OAuth secrets.
# ===================================================

# --- Server Configuration ---
PORT=3000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"
API_PREFIX="/api/v1"

# --- Database Configuration (PostgreSQL - for Tasks 12+) ---
DATABASE_URL="postgresql://<your-db-username>:<your-db-password>@localhost:5432/drug_visualizer_dev"
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="drug_visualizer_dev"
DB_USER="<your-db-username>"
DB_PASSWORD="<your-db-password>"

# --- Authentication (Google OAuth 2.0 / OIDC - for Tasks 17+) ---
GOOGLE_CLIENT_ID="<your-google-client-id>.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="<your-google-client-secret>"
JWT_SECRET="<your-secure-jwt-secret-min-32-chars>"
SESSION_SECRET="<your-secure-session-secret>"
