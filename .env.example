# ==============================================================================
# Drug Path Visualiser (BioLumen) — Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to `.env` for local development or deploy to your production
#    secret management provider (e.g. AWS Secrets Manager, GCP Secret Manager, Vault).
# 2. NEVER commit `.env`, private keys, passwords, or OAuth secrets to source control.
# 3. For production, generate high-entropy random strings for all secrets (>= 32 chars).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration (Vite / Browser Client)
# ------------------------------------------------------------------------------
# Title displayed in browser tabs and meta tags
VITE_APP_TITLE="Drug Path Visualiser — BioLumen"

# Public API Base URL reachable by client browsers:
# - Local Development: http://localhost:3000/api/v1
# - Production: https://api.yourdomain.com/api/v1 (or https://yourdomain.com/api/v1 via reverse proxy)
VITE_API_BASE_URL="http://localhost:3000/api/v1"

# Environment mode: 'development' | 'production' | 'test'
VITE_APP_ENV="development"

# ------------------------------------------------------------------------------
# 2. Backend Server Configuration (Node.js / Express)
# ------------------------------------------------------------------------------
# Server listening port
PORT=3000

# Runtime environment: 'development' | 'production' | 'test'
# Setting to 'production' enforces strict CORS checks and security validations.
NODE_ENV="development"

# Allowed CORS Origins (comma-separated for multiple origins, or specific domain):
# - Development: http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173
# - Production: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# ------------------------------------------------------------------------------
# 3. Relational Database Configuration (PostgreSQL 14+)
# ------------------------------------------------------------------------------
# Primary Connection String (takes precedence over individual DB_* variables):
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL="postgresql://<db-username>:<db-password>@localhost:5432/drug_visualizer_dev"

# Discrete Connection Parameters (fallback if DATABASE_URL is not set):
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="drug_visualizer_dev"
DB_USER="<db-username>"
DB_PASSWORD="<db-password>"

# Connection Pool Settings:
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 4. Authentication, Tokens & Security Secrets
# ------------------------------------------------------------------------------
# JSON Web Token Secret (MANDATORY: Minimum 32 characters of high-entropy randomness)
# Generate with: openssl rand -hex 32
JWT_SECRET="<generate-minimum-32-character-cryptographic-hex-secret>"
JWT_EXPIRES_IN="7d"

# Session Secret for cookie signing and CSRF defense
SESSION_SECRET="<generate-minimum-32-character-session-secret>"

# Authorized Administrative Email Accounts (comma-separated):
ADMIN_EMAILS="admin@biolumen.org,lead.pharmacologist@biolumen.org"

# ------------------------------------------------------------------------------
# 5. External OAuth 2.0 Identity Provider (Google Cloud Identity)
# ------------------------------------------------------------------------------
# Configure in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0
# When unconfigured, application operates securely in local credential authentication mode.
GOOGLE_CLIENT_ID="<your-oauth-client-id>.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="<your-oauth-client-secret>"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"
